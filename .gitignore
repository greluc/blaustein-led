# Cargo build output. Cargo.lock stays tracked: this crate produces a firmware
# binary, and the lockfile keeps builds reproducible across clones.
/target/
**/*.rs.bk

# Flashable images exported by hand
*.elf
*.uf2
*.bin
*.hex

# IDEs
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vs/
.history/
*.swp
*~

# Operating systems
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
